classDiagram
    %% Legend: fields typed Optional~T~ are optional (may be None); all other fields are required
    %% (fields with a default value, such as priority, can be omitted when constructing).

    class Owner {
        +str name
        +int available_minutes_per_day
        +list~Pet~ pets
        +add_pet(pet) void
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +Optional~int~ age
        +Optional~str~ notes
        +list~Task~ tasks
        +add_task(task) void
        +edit_task(task, **changes) void
        +get_pending_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +bool is_completed
        +str pet_name
        +mark_complete() void
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Scheduler {
        +Owner owner
        +generate_plan() DailyPlan
    }

    class DailyPlan {
        +list~Task~ scheduled_tasks
        +list~Task~ skipped_tasks
        +total_minutes() int
        +explain() str
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" o-- "*" Task : has
    Task --> Priority : uses
    Scheduler --> Owner : plans for
    Scheduler ..> DailyPlan : creates
    DailyPlan o-- "*" Task : schedules / skips
